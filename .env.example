# Copy this file to .env and replace the placeholders with your values.
# src/config.py loads .env (or local.settings.json) when ENV is not already set.

ENV=local
BUCKET_NAME=gs://your-bucket-name
CREDENTIALS_JSON_FILE_PATH=path/to/your-service-account.json
PROJECT_ID=your-gcp-project-id
MODEL_ID=your-automl-model-id
